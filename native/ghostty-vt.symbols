# The parts of libghostty-vt's C API that the app binds, one regular expression per line.
# generate-bindings.sh asks jextract for every symbol in ghostty/vt.h and keeps the ones
# that match. Add a pattern here, then run `mise run bindings`.

# Lifecycle and I/O
ghostty_terminal_(new|free|vt_write|resize|get|set|scroll_viewport)
ghostty_free
GhosttyTerminalScrollViewport(Value)?
GHOSTTY_SCROLL_VIEWPORT_.*
GHOSTTY_TERMINAL_DATA_.*
GHOSTTY_TERMINAL_OPT_COLOR_.*
GHOSTTY_(SUCCESS|OUT_OF_MEMORY|INVALID_VALUE|OUT_OF_SPACE|NO_VALUE|IO_ERROR|LIMIT_EXCEEDED|REJECTED)

# Restoring a terminal from a snapshot
ghostty_snapshot_decoder_(new_buf|decode|get|free)
ghostty_snapshot_encode_alloc
GHOSTTY_SNAPSHOT_DECODER_DATA_.*

# Reading what to draw
ghostty_render_state_(new|free|update|clean|get|set)
ghostty_render_state_row_iterator_(new|free|next)
ghostty_render_state_row_(get|set)
ghostty_render_state_row_cells_(new|free|next|get)
ghostty_cell_get
GHOSTTY_RENDER_STATE_(DIRTY|DATA|OPTION|ROW_DATA|ROW_OPTION|ROW_CELLS_DATA|CURSOR_VISUAL_STYLE)_.*
GHOSTTY_CELL_(DATA|WIDE)_.*
GHOSTTY_STYLE_COLOR_.*
GHOSTTY_SGR_UNDERLINE_.*
GhosttyRenderState(Colors|Cursor)
GhosttyStyle(Color|ColorValue)?
GhosttyColorRgb
ghostty_color_palette_default

# Pasting: whether the program wants pastes bracketed, and encoding text safely
ghostty_paste_encode
GhosttyTerminalModeConfig

# The terminal as text, for tests and diagnostics
ghostty_formatter_(terminal_new|format_alloc|free)
GHOSTTY_FORMATTER_FORMAT_.*
GhosttyFormatter(TerminalOptions|TerminalExtra|ScreenExtra)

# Mouse: turning clicks, movement and the wheel into what the program asked to be sent
ghostty_mouse_encoder_(new|free|setopt|setopt_from_terminal|reset|encode)
ghostty_mouse_event_(new|free|set_action|set_button|clear_button|set_mods|set_position)
GhosttyMouse(EncoderSize|Position)
GHOSTTY_MOUSE_(ACTION|BUTTON|ENCODER_OPT)_.*
GHOSTTY_MODS_(SHIFT|CTRL|ALT)
